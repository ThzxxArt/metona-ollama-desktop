{
  "name": "metona-ollama-desktop",
  "version": "0.18.0",
  "description": "Metona Ollama - 本地优先的桌面 AI Agent，支持本地/远程 Ollama 与 Ollama Cloud",
  "main": "dist/main/main.js",
  "desktopName": "metona-ollama",
  "author": "ThzxxArt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThzxxArt/metona-ollama-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/ThzxxArt/metona-ollama-desktop/issues"
  },
  "homepage": "https://github.com/ThzxxArt/metona-ollama-desktop#readme",
  "scripts": {
    "dev:renderer": "vite build --watch",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron . --no-sandbox",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:nsis": "npm run build && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write \"src/shared/**/*.ts\" \"src/main/ollama/**/*.ts\" \"src/main/ipc/**/*.ts\" \"src/main/db/**/*.ts\" \"src/main/tools/**/*.ts\" \"src/renderer/api/**/*.ts\" \"src/renderer/services/agent/**/*.ts\" \"src/renderer/services/context/**/*.ts\" \"src/renderer/services/tools/**/*.ts\" \"src/renderer/features/**/*.ts\" \"src/renderer/components/settings-modal.ts\" \"src/renderer/components/tools-modal.ts\" \"src/renderer/components/model-bar.ts\" \"src/renderer/main.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/shared/**/*.ts\" \"src/main/ollama/**/*.ts\" \"src/main/ipc/**/*.ts\" \"src/main/db/**/*.ts\" \"src/main/tools/**/*.ts\" \"src/renderer/api/**/*.ts\" \"src/renderer/services/agent/**/*.ts\" \"src/renderer/services/context/**/*.ts\" \"src/renderer/services/tools/**/*.ts\" \"src/renderer/features/**/*.ts\" \"src/renderer/components/settings-modal.ts\" \"src/renderer/components/tools-modal.ts\" \"src/renderer/components/model-bar.ts\" \"src/renderer/main.ts\" \"tests/**/*.ts\"",
    "check:no-temperature": "node scripts/check-no-temperature.mjs"
  },
  "build": {
    "appId": "com.metona.ollama-desktop",
    "productName": "Metona Ollama",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!node_modules/**/*",
      "node_modules/zod/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/llama.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/llama.png",
      "category": "Utility",
      "syncDesktopName": true,
      "executableName": "metona-ollama",
      "maintainer": "ThzxxArt <ThzxxArt@users.noreply.github.com>"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/llama.png",
      "category": "public.app-category.productivity",
      "artifactName": "Metona.Ollama.v${version}-mac-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Metona.Ollama.v${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "metona-ollama_${version}_${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Metona.Ollama.Setup.v${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Metona Ollama",
      "installerIcon": "assets/icons/llama.ico",
      "uninstallerIcon": "assets/icons/llama.ico",
      "installerHeaderIcon": "assets/icons/llama.ico"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
